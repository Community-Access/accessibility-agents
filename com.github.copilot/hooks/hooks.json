{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "node \"${PLUGIN_ROOT}/hooks/guard.mjs\" --behaviour detect --client copilot",
        "powershell": "node \"${PLUGIN_ROOT}/hooks/guard.mjs\" --behaviour detect --client copilot",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "node \"${PLUGIN_ROOT}/hooks/guard.mjs\" --behaviour gate --client copilot",
        "powershell": "node \"${PLUGIN_ROOT}/hooks/guard.mjs\" --behaviour gate --client copilot",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "node \"${PLUGIN_ROOT}/hooks/guard.mjs\" --behaviour mark --client copilot",
        "powershell": "node \"${PLUGIN_ROOT}/hooks/guard.mjs\" --behaviour mark --client copilot",
        "timeoutSec": 10
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "bash": "node \"${PLUGIN_ROOT}/hooks/guard.mjs\" --behaviour mark --client copilot",
        "powershell": "node \"${PLUGIN_ROOT}/hooks/guard.mjs\" --behaviour mark --client copilot",
        "timeoutSec": 10
      }
    ]
  }
}
