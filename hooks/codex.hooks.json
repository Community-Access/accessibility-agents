{
  "$comment": "Codex event names mapped onto hooks/guard.mjs. Codex exposes SubagentStop and Stop, so it gets the full gate.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node ${PLUGIN_ROOT}/hooks/guard.mjs --behaviour detect --client codex", "statusMessage": "Checking accessibility dispatch" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|shell",
        "hooks": [
          { "type": "command", "command": "node ${PLUGIN_ROOT}/hooks/guard.mjs --behaviour gate --client codex", "statusMessage": "Enforcing accessibility review" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "node ${PLUGIN_ROOT}/hooks/guard.mjs --behaviour mark --client codex", "statusMessage": "Recording accessibility review" }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "node ${PLUGIN_ROOT}/hooks/guard.mjs --behaviour persist --client codex" }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node ${PLUGIN_ROOT}/hooks/guard.mjs --behaviour persist --client codex" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node ${PLUGIN_ROOT}/hooks/guard.mjs --behaviour finalize --client codex", "timeout": 30 }
        ]
      }
    ]
  }
}
