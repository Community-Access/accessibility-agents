#!/bin/sh
#
# Pre-commit hook: the fast gates, on what is staged.
#
# Two checks, both under ten seconds:
#   1. If anything under skills/ is staged, the package validator runs. It checks
#      the Agent Skills frontmatter rules, the tier model, the dispatch contract
#      and that every specialist is reachable. It runs on the whole package
#      because those checks are cross-file: a router's matrix is only right in
#      relation to every other skill.
#   2. Staged Markdown is linted with markdownlint-cli2, using the local install
#      when present so the hook does not need the network.
#
# The slow gates (the specification validator, live client sessions, the MCP
# suite) run in CI through `npm run verify`, not here.
#
# Install: node scripts/install-hooks.js, or copy this file to .git/hooks/pre-commit
# Bypass (emergency only): git commit --no-verify

STAGED_SKILLS=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^skills/' || true)
STAGED_MARKDOWN=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.md$' | grep -Ev '(^|/)(node_modules|\.git|\.history|\.agents)(/|$)' || true)

if [ -z "$STAGED_SKILLS" ] && [ -z "$STAGED_MARKDOWN" ]; then
  exit 0
fi

echo ""
echo "============================================================"
echo "  Pre-commit: validating staged content"
echo "============================================================"

if [ -n "$STAGED_SKILLS" ]; then
  echo ""
  echo "  skills/ changed; running the package validator..."
  if ! node scripts/validate-skills.mjs --no-shadow-trees; then
    echo ""
    echo "============================================================"
    echo "  COMMIT BLOCKED: fix the skill errors above."
    echo "  Run by hand:  node scripts/validate-skills.mjs"
    echo "  Bypass (not recommended):  git commit --no-verify"
    echo "============================================================"
    echo ""
    exit 1
  fi
  if ! node scripts/build-dispatch-matrices.mjs --check; then
    echo ""
    echo "  COMMIT BLOCKED: a dispatch matrix is stale."
    echo "  Run:  node scripts/build-dispatch-matrices.mjs   and stage the result."
    echo ""
    exit 1
  fi
fi

if [ -n "$STAGED_MARKDOWN" ]; then
  echo ""
  echo "  Linting staged Markdown..."
  if [ -x node_modules/.bin/markdownlint-cli2 ]; then
    LINT="node_modules/.bin/markdownlint-cli2"
  elif command -v npx >/dev/null 2>&1; then
    LINT="npx -y markdownlint-cli2"
  else
    echo ""
    echo "  COMMIT BLOCKED: markdownlint-cli2 is not installed. Run: npm install"
    echo ""
    exit 1
  fi
  # shellcheck disable=SC2086
  if ! $LINT $STAGED_MARKDOWN; then
    echo ""
    echo "============================================================"
    echo "  COMMIT BLOCKED: fix the Markdown issues above."
    echo "  Most are whitespace; try:  $LINT --fix <files>"
    echo "  Bypass (not recommended):  git commit --no-verify"
    echo "============================================================"
    echo ""
    exit 1
  fi
fi

echo ""
echo "  Pre-commit checks passed."
echo ""
exit 0
